# Database
DB_PASSWORD=your_strong_password_here

# Optional authentication: set CLERK_SECRET_KEY and the frontend
# VITE_CLERK_PUBLISHABLE_KEY to enable Clerk sign-in. The server-side
# CLERK_PUBLISHABLE_KEY is an optional fallback for custom-domain discovery.
# Leave Clerk keys unset to use isolated, browser-scoped guest sessions.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Recommended in guest mode to keep signed sessions valid across API restarts.
# Generate a random value with: openssl rand -base64 32
SESSION_SECRET=

# Optional comma-separated exact origins if the browser app is hosted on a
# different origin from the API (for example: https://app.example.com).
CORS_ALLOWED_ORIGINS=
