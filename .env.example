# Postgres / Docker Compose
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=taskflow
DATABASE_URL=postgresql://taskflow:your_strong_password_here@postgres:5432/taskflow

# API
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Better Auth (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Resend email delivery
RESEND_API_KEY=
# Use a verified sender in production. Resend's onboarding address is for testing only.
AUTH_EMAIL_FROM=TaskFlow <noreply@yourdomain.com>
